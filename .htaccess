# ===== Династия Дерева — правила для Beget (Apache) =====
RewriteEngine On

# --- Страница 404 ---
ErrorDocument 404 /404.html

# /projects — реальная папка; отключаем авто-редирект на слэш,
# чтобы Apache не перебивал реврайт на projects.html
DirectorySlash Off

# --- Служебное закрыто от веба ---
RewriteRule ^server/ - [F,L]
RewriteRule \.pdf$ - [F,L]
RewriteRule ^\.git - [F,L]
RewriteRule \.env$ - [F,L]

# --- 301: www -> основной домен без www ---
RewriteCond %{HTTP_HOST} ^www\.derevo-777\.ru$ [NC]
RewriteRule ^(.*)$ https://derevo-777.ru/$1 [R=301,L]

# --- 301: дубли главной — «/?», «/?/», «/?123» и повторные слэши «////».
#     Цель заканчивается на «?» — это сбрасывает сохранённый запрос
#     (иначе редирект ведёт сам на себя и браузер зацикливается) ---
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /\?[/\d]*\ HTTP/ [OR]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /{2,}\ HTTP/ [OR]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /{2,}[/\d]*\ HTTP/
RewriteRule .* https://derevo-777.ru/? [R=301,L]

# --- 301: /index.html -> главная ---
RewriteCond %{THE_REQUEST} \s/index\.html?\s [NC]
RewriteRule ^index\.html?$ https://derevo-777.ru [R=301,L]

# --- 301: /index и /index/ -> главная (иначе их отдаёт реврайт красивых адресов) ---
RewriteCond %{THE_REQUEST} \s/index/?[\s?] [NC]
RewriteRule ^index/?$ https://derevo-777.ru [R=301,L]

# --- 301: слэш на конце URL -> адрес без слэша.
#     DirectorySlash Off отключил авто-редирект Apache, поэтому /projects/
#     и /contacts/ иначе падают во внутренние реврайты и ErrorDocument ---
RewriteRule ^(.+)/$ https://derevo-777.ru/$1 [R=301,L]

# --- Несуществующий путь глубже существующей страницы (/contacts/1) -> сразу 404.
#     Первый сегмент совпадает с именем страницы (contacts.html), и хостинг
#     вместо чистой 404 уходит в content negotiation и внутренние редиректы (500).
#     Реальные файлы и страницы проектов (/projects/<id>) не задеваем ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html !-f
RewriteCond %{REQUEST_URI} ^/([a-z0-9\-]+)/ [NC]
RewriteCond %{DOCUMENT_ROOT}/%1\.html -f
RewriteRule ^ - [R=404,L]

# --- favicon.ico нет в корне (только svg) — отдаём svg, чтобы не плодить 404 в консоли ---
RewriteRule ^favicon\.ico$ assets/img/favicon.svg [L]

# --- 301: адреса с .html -> красивые, всегда по https (страница доступна по одному адресу) ---
RewriteCond %{THE_REQUEST} \s/([^\s?]*)\.html[\s?]
RewriteCond %{DOCUMENT_ROOT}/%1\.html -f
RewriteRule ^(.*)\.html$ https://derevo-777.ru/$1 [R=301,L]

# --- Заголовки безопасности ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://yandex.ru https://yastatic.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://mc.yandex.ru https://yastatic.net https://*.yandex.ru https://avatars.mds.yandex.net; font-src 'self' data:; connect-src 'self' https://mc.yandex.ru https://yandex.ru; frame-src 'self' https://yandex.ru https://*.yandex.ru https://yastatic.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# --- API заявок и админки (те же адреса, что в Node-версии) ---
RewriteRule ^api/admin/login$ api.php?act=login [L]
RewriteRule ^api/statuses$ api.php?act=statuses [L,QSA]
RewriteRule ^api/files/([0-9]+)$ api.php?act=file&id=$1 [L,QSA]
RewriteRule ^api/leads/([0-9]+)$ api.php?act=lead&id=$1 [L,QSA]
RewriteRule ^api/leads/?$ api.php?act=leads [L,QSA]

# --- Админ-панель ---
RewriteRule ^admin/?$ admin.html [L]

# --- Красивые адреса без .html: /projects -> projects.html,
#     /projects/<id> -> projects/<id>.html ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# --- Кэш статики ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
